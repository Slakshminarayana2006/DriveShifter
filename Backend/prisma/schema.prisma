generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
    id                  String          @id         @default(uuid())
    googleId            String          @unique
    name                String
    email               String          @unique
    picture             String?


    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt


    googleAccounts      GoogleAccount[]
    destinationAccount  DestinationAccount?
    transfers           Transfer[]
}


model GoogleAccount {
    id                  String          @id         @default(uuid())
    googleId            String          @unique
    email               String
    accessToken         String
    refreshToken        String
    expiryDate          DateTime  
        
    userId              String          @unique
    user                User            @relation(fields : [userId], references : [id])


    createdAt           DateTime        @default(now())
}


enum TransferStatus {
    PENDING
    SUCCESS
    FAILED
}


model Transfer {
    id                  String          @id     @default(uuid())
    fileId              String          
    fileName            String          
    fileSize            BigInt


    sourceEmail         String
    destinationEmail    String


    status              TransferStatus

    userId              String          
    user                User            @relation(fields : [userId], references : [id])


    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

}


model DestinationAccount {
    id                  String          @id         @default(uuid())
    googleId            String          @unique
    email               String
    accessToken         String
    refreshToken        String
    expiryDate          DateTime
    userId              String          @unique
    user                User            @relation(fields : [userId], references : [id])
}